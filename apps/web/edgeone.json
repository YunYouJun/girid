{
  "buildCommand": "pnpm build",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "outputDirectory": ".edgeone",
  "nodeVersion": "24.5.0",
  "headers": [
    {
      "source": "/_nuxt/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
