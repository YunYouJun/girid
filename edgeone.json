{
  "buildCommand": "pnpm generate",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "outputDirectory": "apps/web/.output/public",
  "nodeVersion": "24.5.0",
  "rewrites": [
    {
      "source": "/*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/_nuxt/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
